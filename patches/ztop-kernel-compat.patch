+    {
+        return -EINVAL;
+    }
+    return add_station(wiphy, ndev, mac, params);
+}
+
+static zt_s32 _zt_w_change_station(struct wiphy *wiphy,
+                                   struct wireless_dev *wdev,
+                                   const zt_u8 *mac,
+                                   struct station_parameters *params)
+{
+    struct net_device *ndev = ZT_WDEV_TO_NDEV(wdev);
+    if (!ndev)
+    {
+        return -EINVAL;
+    }
+    return change_station(wiphy, ndev, mac, params);
 }
+
+static zt_s32 _zt_w_del_station(struct wiphy *wiphy,
+                                struct wireless_dev *wdev,
+                                struct station_del_parameters *params)
+{
+    struct net_device *ndev = ZT_WDEV_TO_NDEV(wdev);
+    if (!ndev)
+    {
+        return -EINVAL;
+    }
+    return del_station(wiphy, ndev, params);
+}
+
+static zt_s32 _zt_w_dump_station(struct wiphy *wiphy,
+                                 struct wireless_dev *wdev, zt_s32 idx,
+                                 zt_u8 *mac, struct station_info *sinfo)
+{
+    struct net_device *ndev = ZT_WDEV_TO_NDEV(wdev);
+    if (!ndev)
+    {
+        return -EINVAL;
+    }
+    return dump_station(wiphy, ndev, idx, mac, sinfo);
+}
