+/*
+ * ---------------------------------------------------------------------------
+ * cfg80211_ops compatibility shims
+ * ---------------------------------------------------------------------------
+ * Kernel 7.0 changed eight cfg80211_ops callbacks from taking
+ * "struct net_device *" to "struct wireless_dev *". Verified against the
+ * real headers of both kernels we target:
+ *
+ *   6.12.107+deb13 (the t630):  add_key/get_key/del_key/get_station/
+ *                               add_station/del_station/change_station/
+ *                               dump_station  all take net_device *
+ *   7.1.5          (this box):  the same eight take wireless_dev *
+ *
+ * The implementations below all expect a net_device (they call
+ * netdev_priv() on it), so on 7.x we interpose thin wrappers that
+ * translate wdev -> wdev->netdev. Without this the kernel hands the
+ * driver a wireless_dev *, netdev_priv() reads past the wrong struct,
+ * and the first key installation during a WPA2 handshake oopses --
+ * i.e. it dies exactly at connect time.
+ *
+ * Note this must NOT be gated on the 6.9.0 boundary some forks use:
+ * 6.12.107 still uses the old signatures, so a 6.9 gate breaks Debian 13.
+ */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0))
+
+#define ZT_WDEV_TO_NDEV(_wdev)                                  \
+    ({                                                          \
+        struct net_device *__nd =                               \
+            (_wdev) ? (_wdev)->netdev : NULL;                   \
+        __nd;                                                   \
+    })
+
+static zt_s32 _zt_w_add_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+                            int link_id, zt_u8 key_index, bool pairwise,
+                            const zt_u8 *mac_addr,
+                            struct key_params *params)
+{
+    struct net_device *ndev = ZT_WDEV_TO_NDEV(wdev);
+    if (!ndev)
+    {
+        return -EINVAL;
+    }
+    return _add_key_cb(wiphy, ndev, link_id, key_index, pairwise, mac_addr,
+                       params);
+}
+
+static zt_s32 _zt_w_get_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+                            int link_id, zt_u8 key_index, bool pairwise,
+                            const zt_u8 *mac_addr, void *cookie,
+                            void (*callback)(void *cookie,
+                                             struct key_params *))
+{
+    struct net_device *ndev = ZT_WDEV_TO_NDEV(wdev);
+    if (!ndev)
+    {
+        return -EINVAL;
+    }
+    return _get_key_cb(wiphy, ndev, link_id, key_index, pairwise, mac_addr,
+                       cookie, callback);
+}
+
+static zt_s32 _zt_w_del_key(struct wiphy *wiphy, struct wireless_dev *wdev,
+                            int link_id, zt_u8 key_index, bool pairwise,
+                            const zt_u8 *mac_addr)
+{
+    struct net_device *ndev = ZT_WDEV_TO_NDEV(wdev);
+    if (!ndev)
+    {
+        return -EINVAL;
+    }
+    return _del_key_cb(wiphy, ndev, link_id, key_index, pairwise, mac_addr);
+}
 
+static zt_s32 _zt_w_get_station(struct wiphy *wiphy,
+                                struct wireless_dev *wdev,
+                                const zt_u8 *mac,
+                                struct station_info *sinfo)
+{
+    struct net_device *ndev = ZT_WDEV_TO_NDEV(wdev);
+    if (!ndev)
+    {
+        return -EINVAL;
+    }
+    return _cfg80211_get_station(wiphy, ndev, mac, sinfo);
