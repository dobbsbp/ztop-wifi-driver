+static zt_s32 _zt_w_add_station(struct wiphy *wiphy,
+                                struct wireless_dev *wdev,
+                                const zt_u8 *mac,
+                                struct station_parameters *params)
+{
+    struct net_device *ndev = ZT_WDEV_TO_NDEV(wdev);
